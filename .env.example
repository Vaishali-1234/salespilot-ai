# SalesPilot AI Environment Configuration
# Copy to .env and configure your keys. Never commit .env to GitHub.

# Primary LLM: Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Secondary Fallback (if Gemini unavailable)
OPENAI_API_KEY=

# Voice Layer Configuration
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
EDGE_TTS_VOICE=en-US-AriaNeural

# Embedding & Vector Store
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_DIR=./data/faiss_index

# Persistence & Server
DATABASE_URL=sqlite:///./data/salespilot_crm.db
BACKEND_URL=http://127.0.0.1:8000
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
